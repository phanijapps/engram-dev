{
  "$id": "https://schemas.example.org/loom/0.1.0/spine.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loom Spine",
  "description": "The machine authority for one initiative: nodes, relations, task states, attempts, evidence. Derived from the Versioned Solution Graph harness schema (docs/product/Harness.schema.json); enums and formats are aligned, the runtime plane is file-local. Extendable only through namespaced extension envelopes.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "spine_id": { "$ref": "#/$defs/Id" },
    "profile": { "enum": ["generic", "pi", "claude", "codex"] },
    "created_at": { "$ref": "#/$defs/Timestamp" },
    "created_by": { "$ref": "#/$defs/Id" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "artifacts": {
      "type": "object",
      "description": "Role-keyed markdown artifacts the spine refers to (e.g. spec, plan, review).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "default": "text/markdown" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/Node" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/Relation" } },
    "runtime": { "$ref": "#/$defs/Runtime" },
    "extensions": { "$ref": "#/$defs/Extensions" }
  },
  "required": ["schema_version", "spine_id", "profile", "created_at", "created_by", "revision", "artifacts", "nodes", "relations", "runtime", "extensions"],
  "additionalProperties": false,
  "$defs": {
    "Id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,119}$" },
    "Digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Timestamp": { "type": "string", "pattern": "Z$" },
    "Version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "NodeRef": {
      "type": "object",
      "properties": {
        "node_id": { "$ref": "#/$defs/Id" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["node_id"],
      "additionalProperties": false
    },
    "Extensions": {
      "type": "object",
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){2,}$": {
          "type": "object",
          "properties": {
            "version": { "$ref": "#/$defs/Version" },
            "data": { "type": "object" }
          },
          "required": ["version", "data"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Namespaced extension envelopes. Clients extend the spine here; core rejects unknown top-level keys."
    },
    "Node": {
      "type": "object",
      "properties": {
        "node_id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["SOURCE", "GOAL", "METRIC", "REQUIREMENT", "ACCEPTANCE", "CONSTRAINT", "QUESTION", "ASSUMPTION", "DECISION", "DESIGN", "TASK", "VERIFICATION", "EXTENSION"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "body": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "details": { "type": "string" }
          },
          "required": ["text"],
          "additionalProperties": false
        },
        "epistemic_state": { "enum": ["DECLARED", "OBSERVED", "INFERRED", "UNKNOWN", "CONFLICTING"] },
        "provenance_refs": { "type": "array", "items": { "$ref": "#/$defs/NodeRef" } },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "section": { "type": "string" }
            },
            "required": ["artifact"],
            "additionalProperties": false
          }
        },
        "extensions": { "$ref": "#/$defs/Extensions" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "created_by": { "$ref": "#/$defs/Id" }
      },
      "required": ["node_id", "kind", "title", "body", "epistemic_state", "provenance_refs", "artifact_refs", "extensions", "revision", "created_at", "created_by"],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "relation_id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["derived_from", "addresses", "implements", "requires", "checks", "resolves", "supersedes", "conflicts_with", "extension"] },
        "from_ref": { "$ref": "#/$defs/NodeRef" },
        "to_ref": { "$ref": "#/$defs/NodeRef" },
        "epistemic_state": { "enum": ["DECLARED", "OBSERVED", "INFERRED", "CONFLICTING"] },
        "extensions": { "$ref": "#/$defs/Extensions" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "created_by": { "$ref": "#/$defs/Id" }
      },
      "required": ["relation_id", "kind", "from_ref", "to_ref", "epistemic_state", "extensions", "revision", "created_at", "created_by"],
      "additionalProperties": false
    },
    "Runtime": {
      "type": "object",
      "properties": {
        "task_states": { "type": "array", "items": { "$ref": "#/$defs/TaskState" } },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/Attempt" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/Event" } }
      },
      "required": ["task_states", "attempts", "events"],
      "additionalProperties": false
    },
    "TaskState": {
      "type": "object",
      "properties": {
        "task_id": { "$ref": "#/$defs/Id" },
        "state": { "enum": ["PENDING", "READY", "RUNNING", "VERIFYING", "SUCCEEDED", "FAILED", "BLOCKED", "CANCELLED"] },
        "state_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "context": {
          "type": "object",
          "properties": {
            "context_id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
            "digest": { "$ref": "#/$defs/Digest" }
          },
          "required": ["context_id", "digest"],
          "additionalProperties": false
        },
        "escalation": {
          "type": "object",
          "properties": {
            "upstream": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
            "reason": { "type": "string" },
            "at": { "$ref": "#/$defs/Timestamp" }
          },
          "required": ["upstream", "reason", "at"],
          "additionalProperties": false
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "required": ["task_id", "state", "state_version", "attempts", "extensions"],
      "additionalProperties": false
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "attempt_id": { "$ref": "#/$defs/Id" },
        "task_id": { "$ref": "#/$defs/Id" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "finished_at": { "$ref": "#/$defs/Timestamp" },
        "worker": { "type": "string" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "exit_code": { "type": "integer" },
              "output_digest": { "$ref": "#/$defs/Digest" },
              "evidence_level": { "enum": ["attested", "captured"] }
            },
            "required": ["command", "exit_code", "evidence_level"],
            "additionalProperties": false
          }
        },
        "result": { "enum": ["pass", "fail"] },
        "notes": { "type": "string" }
      },
      "required": ["attempt_id", "task_id", "started_at", "finished_at", "worker", "commands", "result"],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "at": { "$ref": "#/$defs/Timestamp" },
        "kind": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      },
      "required": ["at", "kind", "detail"],
      "additionalProperties": false
    }
  }
}
