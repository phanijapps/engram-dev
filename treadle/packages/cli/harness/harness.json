  ],
  "wake": {
    "pi": "context-only",
    "claude": "context-only",
    "codex": "context-only",
    "copilot": "background-command"
  },
  "hooks": [
    {
      "id": "post-tool-check",
      "file": "hooks/post-tool-check.js",
      "wiring": {
        "pi": {
          "kind": "extension",
          "dest": ".pi/extensions/post-tool-check.js"
        },
        "claude": {
          "kind": "settings-hooks",
          "matcher": "PostToolUse",
          "command": "node .harness/hooks/post-tool-check.js"
        },
        "codex": null,
        "copilot": null
      }
    },
    {
      "id": "session-recall",
      "file": "hooks/session-recall.js",
      "wiring": {
        "pi": {
          "kind": "extension",
          "dest": ".pi/extensions/session-recall.js"
        },
        "claude": null,
        "codex": null,
        "copilot": null
      },
      "companions": ["hooks/codex-context.js"]
    },
    {
      "id": "codex-recall-prompt",
      "file": "hooks/session-recall.js",
      "wiring": {
        "codex": {
          "kind": "prompt-file",
          "dest": ".codex/prompts/recall.md",
          "prompt": "hooks/prompts/codex-recall.md"
        }
      }
    },
    {
      "id": "codex-context",
      "file": "hooks/codex-context.js",
      "wiring": {
        "codex": [
          {
            "kind": "config-hooks",
            "matcher": "SessionStart",
            "command": "node .harness/hooks/codex-context.js --host codex --event SessionStart"
          },
          {
            "kind": "config-hooks",
            "matcher": "UserPromptSubmit",
            "command": "node .harness/hooks/codex-context.js --host codex --event UserPromptSubmit"
          }
        ]
      }
    },
    {
      "id": "claude-context",
      "file": "hooks/claude-context.js",
      "companions": ["hooks/codex-context.js"],
      "wiring": {
        "claude": [
          {
            "kind": "settings-hooks",
            "matcher": "SessionStart",
            "command": "node .harness/hooks/claude-context.js --host claude --event SessionStart"
          },
          {
            "kind": "settings-hooks",
            "matcher": "UserPromptSubmit",
            "command": "node .harness/hooks/claude-context.js --host claude --event UserPromptSubmit"
          }
        ]
      }
    },
    {
      "id": "copilot-context",
      "file": "hooks/copilot-context.js",
      "companions": ["hooks/codex-context.js"],
      "wiring": {
        "copilot": [
          {
            "kind": "copilot-hooks",
            "matcher": "sessionStart",
            "command": "node .harness/hooks/copilot-context.js --event sessionStart"
          },
          {
            "kind": "copilot-hooks",
            "matcher": "userPromptSubmitted",
            "command": "node .harness/hooks/copilot-context.js --event userPromptSubmitted"
          }
        ]
      }
    }
  ],
  "version": "0.2.0"
}
