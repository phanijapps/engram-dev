{
  "name": "treadle-root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --build && eslint . && prettier --check . && vitest run",
    "test": "vitest run",
    "build": "tsc --build && node scripts/copy-assets.mjs",
    "clean": "tsc --build --clean",
    "brand:check": "node scripts/brand-check.mjs",
    "brand:set": "node scripts/set-brand.mjs",
    "corpus:regen": "./node_modules/.bin/tsx conformance/generators/gen_corpus.ts",
    "corpus:check": "node scripts/corpus-check.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "coverage": "vitest run --coverage",
    "links": "node scripts/link-check.mjs",
    "package:runtime": "node scripts/package-runtime.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "8.20.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@clack/prompts": "1"
  }
}
