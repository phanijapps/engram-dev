{
  "name": "engram-dev",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "treadle"
  ],
  "description": "The SDD harness \u2014 knowledge first, then a tight loop. Remote install: git clone \u2026 && npm i -g --allow-scripts=engram-dev \"$(npm pack --silent)\"",
  "dependencies": {
    "@treadle/brand": "file:treadle/packages/brand",
    "@treadle/core": "file:treadle/packages/core",
    "@treadle/knowledge": "file:treadle/packages/knowledge",
    "@treadle/web": "file:treadle/packages/web",
    "@treadle/cli": "file:treadle/packages/cli"
  },
  "scripts": {
    "prepare": "cd treadle && corepack enable && pnpm install --frozen-lockfile && pnpm build"
  },
  "bin": {
    "treadle": "./bin/engram.js"
  },
  "bundleDependencies": [
    "@treadle/brand",
    "@treadle/core",
    "@treadle/knowledge",
    "@treadle/web",
    "@treadle/cli"
  ]
}
